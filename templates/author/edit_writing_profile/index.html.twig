{% extends 'base.html.twig' %}

{% block title %}Writing profile · {{ parent() }}{% endblock %}

{% block body %}
    <h1>Writing profile</h1>
    {{ include('author/_nav.html.twig') }}
    <p class="analyze-count">{{ analyzed }} analyzed / {{ library }} in library</p>
    <form method="post" action="{{ path('author_analyze_writing') }}">
        <button class="button button-secondary" type="submit">Analyze my writing</button>
    </form>
    <p class="notice notice-warning">Analyze again replaces your edits.</p>
    {{ render(controller('App\\Author\\ImportArticles\\ImportArticlesController::failedFiles')) }}
    {% for row in jobs %}
        <div class="structure-job">
            <strong>{{ row.label }}</strong>
            {{ include('shared/llm/job_card/_frame.html.twig', {job: row.job}) }}
        </div>
    {% endfor %}
    {{ form_start(form) }}
        <h2>Structure</h2>
        <p class="muted">How your articles are built. Used for the outline and the article.</p>
        {{ form_row(form.openingType) }}
        {{ form_row(form.orderingHabit) }}
        {{ form_row(form.sectionCount) }}
        {{ form_row(form.runningExample) }}
        {{ form_row(form.closing) }}
        <h2>Voice</h2>
        <p class="muted">How your articles sound. Used for the article and section rewrites. Optional.</p>
        {{ form_row(form.tone) }}
        {{ form_row(form.sentenceStyle) }}
        {{ form_row(form.devices) }}
        {{ form_row(form.codeHabit) }}
        {{ form_row(form.samples) }}
        {{ form_row(form.save, {attr: {class: 'button button-primary'}}) }}
    {{ form_end(form) }}
{% endblock %}
