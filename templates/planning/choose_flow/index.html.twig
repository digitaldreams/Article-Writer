{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} · Flows · {{ parent() }}{% endblock %}

{% block body %}
    {% set waiting = job and job.status.value in ['queued', 'working'] %}
    {% set choosable = article.state.value == 'flows' %}

    <p><a href="{{ path('planning_list_plans') }}">Back to plans</a></p>
    {% include 'planning/_steps.html.twig' %}
    <h1>{{ article.title }}</h1>

    <section {% if waiting %}data-controller="page-poll" data-page-poll-interval-value="5000"{% endif %}>
        <h2>Choose, edit or write a flow</h2>
        {% if job and job.status.value != 'done' %}
            {% include 'shared/llm/job_card/_frame.html.twig' with {job: job} only %}
        {% endif %}
        {% if not job and flows is empty and not choosable %}
            <p class="muted">Skipped: this plan went straight to the outline.</p>
        {% endif %}
        {% for flow in flows %}
            <article class="card flow{{ flow.chosen ? ' chosen' : '' }}">
                {% if choosable %}
                    <form method="post" action="{{ path('planning_choose_flow', {id: article.id, flowId: flow.id}) }}">
                        <textarea aria-label="Flow {{ loop.index }}" name="description" rows="5" required>{{ flow.description }}</textarea>
                        <div class="form-actions">
                            {% if flow.chosen %}<span class="badge badge-success">Chosen</span>{% endif %}
                            <button class="button button-primary" type="submit">Choose this flow</button>
                        </div>
                    </form>
                {% else %}
                    <p>{{ flow.description }}</p>
                    {% if flow.chosen %}<div class="form-actions"><span class="badge badge-success">Chosen</span></div>{% endif %}
                {% endif %}
            </article>
        {% endfor %}
        {% if choosable %}
            <article class="card own-flow">
                <form method="post" action="{{ path('planning_write_flow', {id: article.id}) }}">
                    <label for="own-flow">Your own flow</label>
                    <textarea id="own-flow" name="description" rows="5" required placeholder="How the article goes, from which perspective"></textarea>
                    <div class="form-actions">
                        <button class="button button-secondary" type="submit">Use my flow</button>
                    </div>
                </form>
            </article>
        {% endif %}
    </section>
{% endblock %}
