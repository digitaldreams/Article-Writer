{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} · Review · {{ parent() }}{% endblock %}

{% block body %}
    {% set waiting = job and job.status.value in ['queued', 'working'] %}
    {% set decidable = article.state.value == 'finalize' and not waiting %}

    <p><a href="{{ path('planning_list_plans') }}">Back to plans</a></p>
    {% include 'planning/_steps.html.twig' %}
    <div class="page-head">
        <h1>{{ article.title }}</h1>
        <span class="badge badge-neutral">Round {{ round }}</span>
    </div>

    <section {% if waiting %}data-controller="page-poll" data-page-poll-interval-value="5000"{% endif %}>
        <h2>Final checkup</h2>
        {% if job and job.status.value != 'done' %}
            {% include 'shared/llm/job_card/_frame.html.twig' with {job: job} only %}
        {% endif %}

        {% if checkup %}
            {% if checkup.issues is empty %}
                <p class="notice">No issues found.</p>
            {% else %}
                <ul class="issues">
                    {% for issue in checkup.issues %}<li>{{ issue }}</li>{% endfor %}
                </ul>
            {% endif %}
        {% endif %}

        {% for item in items %}
            {# Accept / Reject submit inside the frame, so only this item is redrawn. #}
            <turbo-frame id="review-item-{{ item.id }}">
                <article class="card review-item">
                    {% if item.suggestedTitle is not null %}
                        <div class="before-after">
                            <div><p class="muted">Before</p><h3>{{ item.title }}</h3><p>{{ item.summary }}</p></div>
                            <div><p class="muted">After</p><h3>{{ item.suggestedTitle }}</h3><p>{{ item.suggestedSummary }}</p></div>
                        </div>
                        {% if decidable %}
                            <form class="form-actions" method="post" action="{{ path('planning_decide_suggestion', {id: article.id, itemId: item.id}) }}">
                                <button class="button button-secondary button-small" type="submit" name="decision" value="reject">Reject</button>
                                <button class="button button-primary button-small" type="submit" name="decision" value="accept">Accept</button>
                            </form>
                        {% endif %}
                    {% else %}
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.summary }}</p>
                    {% endif %}
                </article>
            </turbo-frame>
        {% endfor %}
    </section>

    {% if decidable %}
        <section class="decision">
            <form method="post" action="{{ path('planning_approve_plan', {id: article.id}) }}">
                <p class="muted">Undecided suggestions count as rejected. The plan is locked after Approve.</p>
                {% if approve_error %}<p class="field-error">{{ approve_error }}</p>{% endif %}
                <button class="button button-primary" type="submit">Approve and write the article</button>
            </form>

            <form class="card" method="post" action="{{ path('planning_reject_plan', {id: article.id}) }}">
                <label for="reject-reason">Reject with a reason</label>
                <textarea id="reject-reason" name="reason" rows="3">{{ app.request.request.get('reason') }}</textarea>
                {% if reject_error %}<p class="field-error">{{ reject_error }}</p>{% endif %}
                <div class="form-actions">
                    <button class="button button-secondary" type="submit" name="to" value="flows">Back to flows</button>
                    <button class="button button-secondary" type="submit" name="to" value="outline">New outline round</button>
                </div>
            </form>
        </section>
    {% endif %}
{% endblock %}
