{% extends 'base.html.twig' %}

{% block title %}New plan · {{ parent() }}{% endblock %}

{% block body %}
    <p><a href="{{ path('planning_list_plans') }}">Back to plans</a></p>
    <h1>New plan</h1>

    {{ form_start(form) }}
        {{ form_row(form.topic) }}
        {{ form_row(form.idea, {attr: {rows: 14, 'data-controller': 'markdown-editor'}}) }}
        {{ form_row(form.create, {attr: {class: 'button button-primary'}}) }}
    {{ form_end(form) }}
{% endblock %}
